{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TechStore Web (F5)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build TechStore Web",
      "program": "${workspaceFolder}/src/TechStore.Web/bin/Debug/net8.0/TechStore.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/TechStore.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "console": "internalConsole"
    }
  ]
}
